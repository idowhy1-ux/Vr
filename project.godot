; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Police Chase VR"
config/description="Open-world VR mayhem for Meta Quest 3: steal cars, fight cops, telekinesis."
run/main_scene="res://main.tscn"
config/icon="res://icon.png"
config/features=PackedStringArray("4.5", "GL Compatibility")
run/max_fps=0

[autoload]

Game="*res://scripts/game.gd"

[debug]

gdscript/warnings/untyped_declaration=0
gdscript/warnings/unused_parameter=0
gdscript/warnings/integer_division=0
gdscript/warnings/narrowing_conversion=0
gdscript/warnings/shadowed_variable=0
gdscript/warnings/return_value_discarded=0

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/aspect="expand"

[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=90
common/max_physics_steps_per_frame=3
3d/default_gravity=9.8
common/physics_interpolation=false

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/size.mobile=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
lights_and_shadows/directional_shadow/soft_shadow_filter_quality.mobile=1
textures/default_filters/anisotropic_filtering_level=1
environment/defaults/default_clear_color=Color(0.55, 0.7, 0.9, 1)
viewport/transparent_background=false

[xr]

openxr/enabled=true
openxr/foveation_level=3
openxr/foveation_dynamic=true
openxr/startup_alert=false
openxr/submit_depth_buffer=false
shaders/enabled=true
